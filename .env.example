# Supabase browser client configuration (Vite exposes VITE_* at build time)
VITE_SUPABASE_URL="https://*.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_key"

# Server-side Supabase (for API routes — not exposed to browser)
SUPABASE_URL="https://*.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""

# Machine config chat (server-side only — not exposed to browser)
ANTHROPIC_API_KEY=""
MAC_MGMT_URL=""
