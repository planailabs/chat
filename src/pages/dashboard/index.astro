---
import '../../components/chat/style.css';
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Dashboard | plan.ai</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Theme Script (copied from main index for consistency) -->
    <script is:inline>
      (() => {
        const THEME_STORAGE_KEY = 'planai-theme-mode';
        const DARK_BG = '#1e1e1e';
        const LIGHT_BG = '#fcfcfc';
        const DARK_TEXT = '#dadada';
        const LIGHT_TEXT = '#222222';
        const root = document.documentElement;

        const resolveStoredMode = () => {
          try {
            return sessionStorage.getItem(THEME_STORAGE_KEY);
          } catch { return null; }
        };
        const prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
        const storedMode = resolveStoredMode();
        const resolvedTheme = (storedMode === 'dark' || storedMode === 'light') ? storedMode : (prefersDark ? 'dark' : 'light');

        root.setAttribute('data-theme', resolvedTheme);
        root.style.backgroundColor = resolvedTheme === 'dark' ? DARK_BG : LIGHT_BG;
        root.style.color = resolvedTheme === 'dark' ? DARK_TEXT : LIGHT_TEXT;
        root.style.setProperty('color-scheme', resolvedTheme === 'dark' ? 'dark' : 'light');
      })();
    </script>
  </head>
  <body class="bg-primary text-primary transition-colors duration-200">

    <!-- Loading State -->
    <div id="dashboard-loading" class="fixed inset-0 flex items-center justify-center bg-primary z-50">
      <div class="text-lg animate-pulse">Checking access...</div>
    </div>

    <!-- Dashboard Content (Hidden by default) -->
    <div id="dashboard-root" class="hidden min-h-screen flex flex-col p-6 max-w-7xl mx-auto w-full gap-8">

      <!-- Header -->
      <header class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 border-b border-white/10 pb-6">
        <div>
           <h1 class="text-2xl font-bold tracking-tight">Admin Dashboard</h1>
           <p class="text-sm opacity-60 mt-1">Realtime monitoring & user insights</p>
        </div>

        <div class="flex items-center gap-4">
           <!-- Live Toggle -->
           <button id="live-toggle" class="flex items-center gap-2 px-3 py-1.5 rounded-full border border-white/10 hover:bg-white/5 transition-colors text-sm">
             <div id="live-dot" class="w-2 h-2 rounded-full bg-neutral-500"></div>
             <span id="live-text">Live updates: OFF</span>
           </button>
        </div>
      </header>

      <!-- Stats Grid (Charts) -->
      <section class="grid grid-cols-1 lg:grid-cols-2 gap-8">
         <!-- Prompts Over Time -->
         <div class="p-6 rounded-xl border border-white/10 bg-white/5 h-[400px] flex flex-col shadow-sm hover:border-white/20 transition-colors">
            <div class="flex justify-between items-center mb-4 opacity-70">
                <h3 class="text-sm font-medium">Activity (Prompts)</h3>
                <div class="text-xs flex items-center opacity-70">
                   <span>Drag to zoom</span>
                   <span class="mx-2 opacity-50">•</span>
                   <span>Hold Shift to pan</span>
                   <span class="mx-2 opacity-50">•</span>
                   <a href="#" id="chart-reset" class="underline hover:text-white transition-colors">Refresh</a>
                </div>
            </div>
            <div id="chart-activity" class="flex-1 w-full h-full relative">
               <!-- ApexChart mounts here -->
               <div class="absolute inset-0 flex items-center justify-center text-xs opacity-40">Loading chart...</div>
            </div>
         </div>

         <!-- Top Users -->
         <div class="p-6 rounded-xl border border-white/10 bg-white/5 h-[400px] flex flex-col shadow-sm hover:border-white/20 transition-colors">
            <h3 class="text-sm font-medium opacity-70 mb-4">Top Users</h3>
             <div id="chart-users" class="flex-1 w-full h-full relative">
               <!-- ApexChart mounts here -->
               <div class="absolute inset-0 flex items-center justify-center text-xs opacity-40">Loading chart...</div>
            </div>
         </div>
      </section>

      <!-- Data Table -->
      <section class="flex flex-col gap-4">
         <div class="flex justify-between items-center">
            <h2 class="text-lg font-semibold">Recent Messages</h2>

            <div class="flex items-center gap-2 text-sm">
               <label for="rows-limit" class="opacity-70">Rows shown:</label>
               <select id="rows-limit" class="bg-transparent border border-white/10 rounded px-2 py-1 outline-none focus:border-accent">
                  <option value="100">100</option>
                  <option value="200">200</option>
                  <option value="500">500</option>
                  <option value="10000">All</option>
               </select>
            </div>
         </div>

         <div class="overflow-x-auto rounded-lg border border-white/10">
            <table class="w-full text-left text-sm border-collapse">
               <thead class="bg-white/5 text-xs uppercase tracking-wider opacity-70">
                  <tr>
                     <th class="p-4 font-medium border-b border-white/10 w-[180px]">Time</th>
                     <th class="p-4 font-medium border-b border-white/10 w-[250px]">User</th>
                     <th class="p-4 font-medium border-b border-white/10">Prompt Preview</th>
                  </tr>
               </thead>
               <tbody id="messages-table-body" class="divide-y divide-white/5">
                  <!-- Rows injected here -->
                  <tr class="animate-pulse">
                     <td class="p-4 opacity-50" colspan="3">Loading data...</td>
                  </tr>
               </tbody>
            </table>
         </div>
         <div id="table-footer-status" class="text-xs text-center opacity-40 py-4">
            Showing latest records
         </div>
      </section>

    </div>

    <!-- Modal for Full Text -->
    <div id="text-modal" class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/80 backdrop-blur-sm p-4">
       <div class="bg-[#1e1e1e] border border-white/10 rounded-xl w-full max-w-2xl max-h-[80vh] flex flex-col shadow-2xl relative">
          <button id="modal-close" class="absolute top-4 right-4 text-white/50 hover:text-white p-2">✕</button>

          <div class="p-6 border-b border-white/10">
             <h3 class="text-lg font-semibold">Full Prompt</h3>
             <div id="modal-meta" class="text-xs opacity-50 mt-1">User info here</div>
          </div>

          <div class="p-6 overflow-y-auto flex-1 bg-black/20">
             <pre id="modal-content" class="whitespace-pre-wrap font-mono text-sm leading-relaxed opacity-90 select-text"></pre>
          </div>

          <div class="p-4 border-t border-white/10 flex justify-end">
             <button id="modal-copy" class="px-4 py-2 rounded bg-white/5 hover:bg-white/10 text-sm transition-colors border border-white/5 whitespace-nowrap flex items-center justify-center gap-2 min-w-[140px]">
                Copy Message
             </button>
          </div>
       </div>
    </div>

    <!-- Client Logic -->
    <script>
       import { enforceAdminAccess, signOutAdmin } from '../../components/dashboard/logic.ts';
       import { resetActivityZoom } from '../../components/dashboard/charts.ts';

       // Init
       (async () => {
         const isAdmin = await enforceAdminAccess();
         if (isAdmin) {
            document.getElementById('dashboard-loading').classList.add('hidden');
            document.getElementById('dashboard-root').classList.remove('hidden');

            // Initialize Dashboard Logic (dynamic import to avoid loading ApexCharts until auth confirmed)
            const { initDashboard } = await import('../../components/dashboard/app.ts');
            initDashboard();
         }
       })();

       // Global Handlers
       // document.getElementById('sign-out-btn')?.addEventListener('click', signOutAdmin);
       document.getElementById('chart-reset')?.addEventListener('click', (e) => {
          e.preventDefault();
          resetActivityZoom();
       });

       // UI helpers
       document.getElementById('modal-close')?.addEventListener('click', () => {
          document.getElementById('text-modal').classList.add('hidden');
       });
       document.getElementById('text-modal')?.addEventListener('click', (e) => {
          if (e.target.id === 'text-modal') {
             document.getElementById('text-modal').classList.add('hidden');
          }
       });
    </script>
  </body>
</html>
