---
import '../../../components/chat/style.css';
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Customer Tokens | Admin | plan.ai</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <script is:inline>
      (() => {
        const THEME_STORAGE_KEY = 'planai-theme-mode';
        const root = document.documentElement;
        const resolveStoredMode = () => { try { return sessionStorage.getItem(THEME_STORAGE_KEY); } catch { return null; } };
        const prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
        const storedMode = resolveStoredMode();
        const resolved = (storedMode === 'dark' || storedMode === 'light') ? storedMode : (prefersDark ? 'dark' : 'light');
        root.setAttribute('data-theme', resolved);
        root.style.backgroundColor = resolved === 'dark' ? '#1e1e1e' : '#fcfcfc';
        root.style.color = resolved === 'dark' ? '#dadada' : '#222222';
        root.style.setProperty('color-scheme', resolved === 'dark' ? 'dark' : 'light');
      })();
    </script>
  </head>
  <body class="bg-primary text-primary transition-colors duration-200">

    <div id="loading" class="fixed inset-0 flex items-center justify-center bg-primary z-50">
      <div class="text-lg animate-pulse">Checking access...</div>
    </div>

    <div id="root" class="hidden min-h-screen flex flex-col p-6 max-w-4xl mx-auto w-full gap-6">

      <header class="flex items-center gap-4 border-b border-white/10 pb-4">
        <a href="/dashboard/" class="text-sm opacity-50 hover:opacity-100 transition-opacity">&larr; Dashboard</a>
        <h1 class="text-xl font-bold tracking-tight">Customer Tokens</h1>
      </header>

      <!-- Search -->
      <div class="flex gap-3 items-end">
        <div class="flex-1">
          <label for="search-input" class="text-xs opacity-50 block mb-1">Search by email</label>
          <input
            id="search-input"
            type="text"
            placeholder="user@example.com"
            class="w-full bg-transparent border border-white/10 rounded-lg px-4 py-2.5 text-sm outline-none focus:border-white/30 transition-colors"
          />
        </div>
        <button id="search-btn" class="px-4 py-2.5 bg-white/5 hover:bg-white/10 border border-white/10 rounded-lg text-sm transition-colors">
          Search
        </button>
      </div>

      <!-- Results -->
      <div id="results" class="hidden flex flex-col gap-3">
        <div id="user-cards"></div>
      </div>

      <!-- Status -->
      <div id="status-msg" class="hidden text-sm text-center py-2 rounded-lg"></div>

    </div>

    <!-- Set Token Modal -->
    <div id="token-modal" class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/80 backdrop-blur-sm p-4">
      <div class="bg-[var(--surface-base,#1e1e1e)] border border-white/10 rounded-xl w-full max-w-lg flex flex-col shadow-2xl">
        <div class="p-6 border-b border-white/10">
          <h3 class="text-lg font-semibold">Set Customer Token</h3>
          <div id="modal-user-info" class="text-xs opacity-50 mt-1"></div>
        </div>
        <div class="p-6 flex flex-col gap-4">
          <div>
            <label for="token-input" class="text-xs opacity-50 block mb-1">mac-mgmt customer token</label>
            <input
              id="token-input"
              type="text"
              placeholder="Paste token here..."
              class="w-full bg-transparent border border-white/10 rounded-lg px-4 py-2.5 text-sm outline-none focus:border-white/30 transition-colors font-mono"
            />
          </div>
          <p class="text-xs opacity-40">Token will be validated against mac-mgmt before saving.</p>
          <div id="modal-error" class="hidden text-xs text-red-400 bg-red-500/10 rounded-lg px-3 py-2"></div>
        </div>
        <div class="p-4 border-t border-white/10 flex justify-end gap-3">
          <button id="modal-cancel" class="px-4 py-2 rounded-lg text-sm hover:bg-white/5 transition-colors">Cancel</button>
          <button id="modal-save" class="px-4 py-2 rounded-lg bg-white/10 hover:bg-white/20 text-sm transition-colors font-medium">Save Token</button>
        </div>
      </div>
    </div>

    <script>
      import { enforceAdminAccess } from '../../../components/dashboard/logic';
      import { getSupabaseClientOrThrow } from '../../../components/chat/supabase/client';

      (async () => {
        const isAdmin = await enforceAdminAccess();
        if (!isAdmin) return;

        document.getElementById('loading')!.classList.add('hidden');
        document.getElementById('root')!.classList.remove('hidden');

        const supabase = getSupabaseClientOrThrow();
        const searchInput = document.getElementById('search-input') as HTMLInputElement;
        const searchBtn = document.getElementById('search-btn') as HTMLButtonElement;
        const results = document.getElementById('results')!;
        const userCards = document.getElementById('user-cards')!;
        const statusMsg = document.getElementById('status-msg')!;

        const tokenModal = document.getElementById('token-modal')!;
        const tokenInput = document.getElementById('token-input') as HTMLInputElement;
        const modalUserInfo = document.getElementById('modal-user-info')!;
        const modalCancel = document.getElementById('modal-cancel')!;
        const modalSave = document.getElementById('modal-save')!;

        const modalError = document.getElementById('modal-error')!;

        let modalUserId = '';
        let modalUserEmail = '';
        let lastSearchResults: any[] = [];

        async function getJwt(): Promise<string> {
          const { data } = await supabase.auth.getSession();
          return data.session?.access_token ?? '';
        }

        function showStatus(msg: string, type: 'success' | 'error') {
          statusMsg.textContent = msg;
          statusMsg.className = `text-sm text-center py-2 rounded-lg ${type === 'success' ? 'text-green-400 bg-green-500/10' : 'text-red-400 bg-red-500/10'}`;
          statusMsg.classList.remove('hidden');
          setTimeout(() => statusMsg.classList.add('hidden'), 4000);
        }

        // ── Search ──────────────────────────────────────────
        async function searchUsers() {
          const q = searchInput.value.trim();
          if (q.length < 2) return;

          searchBtn.textContent = 'Searching...';
          searchBtn.disabled = true;

          try {
            const jwt = await getJwt();
            const res = await fetch(`/api/admin/search-users/?q=${encodeURIComponent(q)}`, {
              headers: { Authorization: `Bearer ${jwt}` },
            });
            const data = await res.json();
            lastSearchResults = data.users ?? [];
            renderUsers(lastSearchResults);
            results.classList.remove('hidden');
          } finally {
            searchBtn.textContent = 'Search';
            searchBtn.disabled = false;
          }
        }

        searchBtn.addEventListener('click', searchUsers);
        searchInput.addEventListener('keydown', (e) => {
          if (e.key === 'Enter') searchUsers();
        });

        // ── Render ──────────────────────────────────────────
        function renderUsers(users: any[]) {
          userCards.innerHTML = '';

          if (users.length === 0) {
            userCards.innerHTML = '<div class="text-sm opacity-40 py-4 text-center">No users found</div>';
            return;
          }

          for (const u of users) {
            const card = document.createElement('div');
            card.className = 'flex items-center justify-between px-4 py-3 rounded-lg border border-white/10 hover:border-white/20 transition-colors';

            const tokenBadge = Boolean(u.customerToken)
              ? `<span class="text-xs px-2 py-0.5 rounded-full bg-green-500/10 text-green-400 border border-green-500/20">Has token</span>`
              : `<span class="text-xs px-2 py-0.5 rounded-full bg-white/5 opacity-40 border border-white/5">No token</span>`;

            card.innerHTML = `
              <div class="flex items-center gap-3">
                <div>
                  <div class="text-sm font-medium">${escapeHtml(u.email ?? 'No email')}</div>
                  <div class="text-xs opacity-40 font-mono">${u.userId.slice(0, 16)}...</div>
                </div>
                ${tokenBadge}
              </div>
              <div class="flex items-center gap-2">
                <button class="set-token-btn px-3 py-1.5 text-xs bg-white/5 hover:bg-white/10 border border-white/10 rounded-lg transition-colors" data-user-id="${u.userId}" data-email="${escapeHtml(u.email ?? '')}">
                  ${Boolean(u.customerToken) ? 'Change Token' : 'Set Token'}
                </button>
                ${Boolean(u.customerToken) ? `<button class="remove-token-btn px-3 py-1.5 text-xs text-red-400 hover:bg-red-500/10 border border-red-500/20 rounded-lg transition-colors" data-user-id="${u.userId}" data-email="${escapeHtml(u.email ?? '')}">Remove token</button>` : ''}
              </div>
            `;
            userCards.appendChild(card);
          }

          // Bind set token buttons
          userCards.querySelectorAll('.set-token-btn').forEach((btn) => {
            btn.addEventListener('click', (e) => {
              const el = e.currentTarget as HTMLElement;
              openTokenModal(el.dataset.userId!, el.dataset.email!);
            });
          });

          // Bind remove token buttons
          userCards.querySelectorAll('.remove-token-btn').forEach((btn) => {
            btn.addEventListener('click', async (e) => {
              const el = e.currentTarget as HTMLElement;
              const userId = el.dataset.userId!;
              const email = el.dataset.email!;

              if (!confirm(`Remove customer token for ${email}?`)) return;

              el.textContent = 'Removing...';
              (el as HTMLButtonElement).disabled = true;

              try {
                const jwt = await getJwt();
                const res = await fetch('/api/admin/customer-token/', {
                  method: 'DELETE',
                  headers: {
                    Authorization: `Bearer ${jwt}`,
                    'Content-Type': 'application/json',
                  },
                  body: JSON.stringify({ userId }),
                });
                const data = await res.json();
                if (res.ok) {
                  showStatus(`Token removed for ${email}`, 'success');
                  // Update local state and re-render
                  const user = lastSearchResults.find((u: any) => u.userId === userId);
                  if (user) {
                    user.hasCustomerToken = false;
                    user.customerToken = null;
                  }
                  renderUsers(lastSearchResults);
                } else {
                  showStatus(data.error ?? 'Failed to remove token', 'error');
                }
              } catch {
                showStatus('Network error', 'error');
              }
            });
          });
        }

        // ── Token Modal ─────────────────────────────────────
        function openTokenModal(userId: string, email: string) {
          modalUserId = userId;
          modalUserEmail = email;
          modalUserInfo.textContent = `${email} (${userId.slice(0, 12)}...)`;
          tokenInput.value = '';
          modalError.classList.add('hidden');
          tokenModal.classList.remove('hidden');
          tokenModal.classList.add('flex');
          tokenInput.focus();
        }

        function closeTokenModal() {
          tokenModal.classList.add('hidden');
          tokenModal.classList.remove('flex');
        }

        modalCancel.addEventListener('click', closeTokenModal);
        tokenModal.addEventListener('click', (e) => {
          if (e.target === tokenModal) closeTokenModal();
        });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && !tokenModal.classList.contains('hidden')) closeTokenModal();
        });

        modalSave.addEventListener('click', async () => {
          const token = tokenInput.value.trim();
          if (!token) return;

          modalSave.textContent = 'Validating...';
          (modalSave as HTMLButtonElement).disabled = true;

          try {
            const jwt = await getJwt();
            const res = await fetch('/api/admin/customer-token/', {
              method: 'PUT',
              headers: {
                Authorization: `Bearer ${jwt}`,
                'Content-Type': 'application/json',
              },
              body: JSON.stringify({ userId: modalUserId, token }),
            });
            const data = await res.json();
            if (res.ok) {
              modalError.classList.add('hidden');
              showStatus(`Token set for ${modalUserEmail}`, 'success');
              closeTokenModal();
              // Update local state and re-render
              const user = lastSearchResults.find((u: any) => u.userId === modalUserId);
              if (user) {
                user.hasCustomerToken = true;
                user.customerToken = token;
              }
              renderUsers(lastSearchResults);
            } else {
              modalError.textContent = data.error ?? 'Failed to set token';
              modalError.classList.remove('hidden');
            }
          } catch {
            modalError.textContent = 'Network error';
            modalError.classList.remove('hidden');
          } finally {
            modalSave.textContent = 'Save Token';
            (modalSave as HTMLButtonElement).disabled = false;
          }
        });

        function escapeHtml(str: string): string {
          const div = document.createElement('div');
          div.textContent = str;
          return div.innerHTML;
        }
      })();
    </script>
  </body>
</html>
