---
import '../../../components/chat/style.css';
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Impersonate User | Admin | plan.ai</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <script is:inline>
      (() => {
        const THEME_STORAGE_KEY = 'planai-theme-mode';
        const root = document.documentElement;
        const resolveStoredMode = () => { try { return sessionStorage.getItem(THEME_STORAGE_KEY); } catch { return null; } };
        const prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
        const storedMode = resolveStoredMode();
        const resolved = (storedMode === 'dark' || storedMode === 'light') ? storedMode : (prefersDark ? 'dark' : 'light');
        root.setAttribute('data-theme', resolved);
        root.style.backgroundColor = resolved === 'dark' ? '#1e1e1e' : '#fcfcfc';
        root.style.color = resolved === 'dark' ? '#dadada' : '#222222';
        root.style.setProperty('color-scheme', resolved === 'dark' ? 'dark' : 'light');
      })();
    </script>
  </head>
  <body class="bg-primary text-primary transition-colors duration-200">

    <div id="loading" class="fixed inset-0 flex items-center justify-center bg-primary z-50">
      <div class="text-lg animate-pulse">Checking access...</div>
    </div>

    <div id="root" class="hidden min-h-screen flex flex-col p-6 max-w-3xl mx-auto w-full gap-6">

      <header class="flex items-center gap-4 border-b border-white/10 pb-4">
        <a href="/dashboard/" class="text-sm opacity-50 hover:opacity-100 transition-opacity">&larr; Dashboard</a>
        <h1 class="text-xl font-bold tracking-tight">Impersonate User</h1>
      </header>

      <p class="text-sm opacity-50">Search for a user by email, then open the chat UI as that user. All API endpoints will return their data.</p>

      <!-- Search -->
      <div class="flex gap-3 items-end">
        <div class="flex-1">
          <label for="search-input" class="text-xs opacity-50 block mb-1">Search by email</label>
          <input
            id="search-input"
            type="text"
            placeholder="user@example.com"
            class="w-full bg-transparent border border-white/10 rounded-lg px-4 py-2.5 text-sm outline-none focus:border-white/30 transition-colors"
            autofocus
          />
        </div>
        <button id="search-btn" class="px-4 py-2.5 bg-white/5 hover:bg-white/10 border border-white/10 rounded-lg text-sm transition-colors">
          Search
        </button>
      </div>

      <!-- Results -->
      <div id="results" class="hidden flex flex-col gap-2">
        <div id="user-list"></div>
      </div>
    </div>

    <script>
      import { enforceAdminAccess } from '../../../components/dashboard/logic';
      import { getSupabaseClientOrThrow } from '../../../components/chat/supabase/client';

      (async () => {
        const isAdmin = await enforceAdminAccess();
        if (!isAdmin) return;

        document.getElementById('loading')!.classList.add('hidden');
        document.getElementById('root')!.classList.remove('hidden');

        const supabase = getSupabaseClientOrThrow();
        const searchInput = document.getElementById('search-input') as HTMLInputElement;
        const searchBtn = document.getElementById('search-btn') as HTMLButtonElement;
        const results = document.getElementById('results')!;
        const userList = document.getElementById('user-list')!;

        async function getJwt(): Promise<string> {
          const { data } = await supabase.auth.getSession();
          return data.session?.access_token ?? '';
        }

        async function searchUsers() {
          const q = searchInput.value.trim();
          if (q.length < 2) return;

          searchBtn.textContent = 'Searching...';
          searchBtn.disabled = true;

          try {
            const jwt = await getJwt();
            const res = await fetch(`/api/admin/search-users?q=${encodeURIComponent(q)}`, {
              headers: { Authorization: `Bearer ${jwt}` },
            });
            const data = await res.json();

            userList.innerHTML = '';
            if (!data.users || data.users.length === 0) {
              userList.innerHTML = '<div class="text-sm opacity-40 py-4 text-center">No users found</div>';
            } else {
              for (const u of data.users) {
                const row = document.createElement('div');
                row.className = 'flex items-center justify-between px-4 py-3 rounded-lg border border-white/10 hover:border-white/20 transition-colors';

                const tokenBadge = u.hasCustomerToken
                  ? '<span class="text-xs px-2 py-0.5 rounded-full bg-green-500/10 text-green-400 border border-green-500/20">Has token</span>'
                  : '<span class="text-xs px-2 py-0.5 rounded-full bg-white/5 opacity-40 border border-white/5">No token</span>';

                row.innerHTML = `
                  <div class="flex items-center gap-3">
                    <div>
                      <div class="text-sm font-medium">${escapeHtml(u.email ?? 'No email')}</div>
                      <div class="text-xs opacity-40 font-mono">${u.userId.slice(0, 16)}...</div>
                    </div>
                    ${tokenBadge}
                  </div>
                  <a
                    href="/?impersonate=${u.userId}"
                    class="px-4 py-2 text-sm bg-white/5 hover:bg-white/10 border border-white/10 rounded-lg transition-colors font-medium"
                  >
                    Open as user
                  </a>
                `;
                userList.appendChild(row);
              }
            }
            results.classList.remove('hidden');
          } finally {
            searchBtn.textContent = 'Search';
            searchBtn.disabled = false;
          }
        }

        searchBtn.addEventListener('click', searchUsers);
        searchInput.addEventListener('keydown', (e) => {
          if (e.key === 'Enter') searchUsers();
        });

        function escapeHtml(str: string): string {
          const div = document.createElement('div');
          div.textContent = str;
          return div.innerHTML;
        }
      })();
    </script>
  </body>
</html>
