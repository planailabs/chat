{
  "name": "plan.ai-chat",
  "version": "0.9.0",
  "private": true,
  "description": "plan.ai chat UI (static, served by the Rust server)",
  "type": "module",
  "source": [
    "index.html",
    "dashboard/index.html"
  ],
  "scripts": {
    "dev": "parcel serve --port 1234",
    "build": "rm -rf dist && parcel build --no-source-maps --dist-dir dist --public-url /",
    "watch": "parcel watch --no-hmr --dist-dir dist --public-url /",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit -p ."
  },
  "dependencies": {
    "apexcharts": "^5.3.6",
    "dompurify": "^3.4.17",
    "marked": "^17.0.5",
    "vue": "^3.5.44",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@parcel/transformer-vue": "^2.16.4",
    "@tailwindcss/postcss": "^4.3.3",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "http-proxy-middleware": "^3.0.5",
    "jsdom": "^25.0.1",
    "parcel": "^2.16.4",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.3.14"
  },
  "@parcel/resolver-default": {
    "packageExports": true
  }
}
